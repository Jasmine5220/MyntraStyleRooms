# Backend server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=

# Generate strong, unique values for both secrets.
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=30d

# Cloudinary (needed for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenAI (needed for AI stylist features)
OPENAI_API_KEY=

# Optional email integration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Comma-separated allowed frontend origins.
# Set these to your actual deployed/local origins for production.
CORS_ORIGIN=http://localhost:8081,http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:3000

# Optional external integrations
MYNTRA_API_KEY=
MYNTRA_API_URL=
REDIS_URL=
